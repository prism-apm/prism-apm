root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,xml,sql,properties,ts,html}]
indent_size = 4

[*.{js,mjs,vue,json,less,css,yml,yaml,md}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.ps1]
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

[Dockerfile*]
indent_size = 4
