<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.prism.apm.ui.server.mapper.project.ProjectProjectGroupMapper">
    <resultMap id="BaseResultMap" type="org.prism.apm.ui.server.entity.model.project.ProjectProjectGroup">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="project_id" property="projectId" jdbcType="INTEGER"/>
        <result column="project_group_id" property="projectGroupId" jdbcType="INTEGER"/>
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <delete id="deleteByProjectIdAndProjectGroupId">
        DELETE FROM project_project_group WHERE project_id = #{projectId} AND project_group_id = #{projectGroupId}
    </delete>

    <select id="findByProjectId" resultMap="BaseResultMap">
        SELECT * FROM project_project_group WHERE project_id = #{projectId}
    </select>

    <select id="findByProjectGroupId" resultMap="BaseResultMap">
        SELECT * FROM project_project_group WHERE project_group_id = #{projectGroupId}
    </select>
</mapper>