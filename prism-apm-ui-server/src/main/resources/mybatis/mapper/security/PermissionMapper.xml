<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.prism.apm.ui.server.mapper.security.PermissionMapper">

    <!-- Existing CRUD mappings can be placed here -->

    <!--
        id: Must exactly match the method name in the Mapper interface (getPermissionWithRoles)
        resultType: Must be the full DTO class path
    -->
    <select id="getPermissionWithRoles" resultType="org.prism.apm.ui.server.entity.dto.security.PermissionWithRoleDTO">
        SELECT
            p.url,
            r.name AS roleName
        FROM
            permissions p
                JOIN role_permission rp ON p.id = rp.permission_id
                JOIN roles r ON rp.role_id = r.id
        WHERE p.url != ''
    </select>

</mapper>