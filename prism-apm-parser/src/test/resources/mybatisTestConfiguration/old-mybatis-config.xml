<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>

    <!-- for TestNGDAOTestBase.java -->
    <settings>
        <setting name="cacheEnabled" value="false"/>
    </settings>


    <environments default="development">
        <environment id="development">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="org.postgresql.Driver"/>
                <property name="url" value="jdbc:postgresql://localhost:${port}/postgres"/>
                <property name="username" value="postgres"/>
                <property name="password" value=""/>
            </dataSource>
        </environment>
    </environments>

    <mappers>
        <mapper resource="mybatis/mapper/ServiceCallMapper.xml"/>
        <mapper resource="mybatis/mapper/FieldContentReplacerRuleMapper.xml"/>
    </mappers>
</configuration>